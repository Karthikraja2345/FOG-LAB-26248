# FOG-LAB 26248 Configuration
APP_NAME=FOG-LAB 26248
APP_ENV=development
SECRET_KEY=foglab-sih2026-simulation-secret-key-change-in-prod
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Database
